        <LangVersion>latest</LangVersion>
        <OverlayerPath Condition="'$(OverlayerPath)' == ''">../../Overlayer/Overlayer</OverlayerPath>
    </PropertyGroup>

    <PropertyGroup>
        <!-- O5Kit (UI + input toolkit). Module is Mono-only: Debug/Release map to O5Kit *_Mono. -->
        <O5KitProject>$(MSBuildProjectDirectory)/../../O5Kit/src/O5Kit/O5Kit.csproj</O5KitProject>
        <O5KitConfiguration Condition="$(Configuration.Contains('Debug'))">Debug_Mono</O5KitConfiguration>
        <O5KitConfiguration Condition="!$(Configuration.Contains('Debug'))">Release_Mono</O5KitConfiguration>
        <UnityPath Condition="'$(UnityPath)' == '' and Exists('/home/kkitut/.local/share/Steam/steamapps/common/Melatonin/Melatonin_Data/Managed/UnityEngine.CoreModule.dll')">/home/kkitut/.local/share/Steam/steamapps/common/Melatonin/Melatonin_Data/Managed</UnityPath>
        <UnityPath Condition="'$(UnityPath)' == ''">$(GamePath)/$(GameData)/Managed</UnityPath>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(O5KitProject)">
            <SetConfiguration>Configuration=$(O5KitConfiguration)</SetConfiguration>
            <SetTargetFramework>TargetFramework=netstandard2.0</SetTargetFramework>
        </ProjectReference>
    </ItemGroup>
	
